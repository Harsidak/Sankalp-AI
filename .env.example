# ============================================================
# SanKalp 2.0 — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=SanKalp
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# --- Database (MySQL) ---
DATABASE_URL=mysql+aiomysql://root:your-password@localhost:3306/sankalp

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- AI / LLM ---
# NVIDIA NIM (build.nvidia.com) — OpenAI-compatible, free tier.
# Get a key at https://build.nvidia.com → any model → "Get API Key".
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENAI_API_KEY=sk-your-openai-key
GOOGLE_API_KEY=your-google-ai-key
DEFAULT_LLM_PROVIDER=nvidia
DEFAULT_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis (Optional) ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
